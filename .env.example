# ─── Server ───────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated origins for Expo/web (optional — defaults cover localhost)
# ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.5:8081

# Allow X-User-Id header for Expo dev before Supabase auth is wired
ALLOW_DEV_USER_HEADER=true

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://bcnncqkclexvmlpuogxo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_PASSWORD=your-database-password

# JWT secret (must match Supabase JWT secret — find it in:
# Supabase Dashboard → Settings → API → JWT Secret)
JWT_SECRET=your-supabase-jwt-secret

# ─── Plaid ────────────────────────────────────────────────
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret        # use sandbox-secret for dev
PLAID_ENV=sandbox                              # sandbox | development | production
PLAID_WEBHOOK_URL=https://your-api.com/webhooks/plaid

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100
